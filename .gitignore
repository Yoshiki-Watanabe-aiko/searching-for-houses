# 環境変数・シークレット
.env
.env.*
!.env.example

# 検索パターン設定
# v2 では Webhook URL を .env へ集約したため、パターンYAML自体はGit管理できる。
# v1 形式の設定（configs/_v1/）と検証用（configs/_test/）は実URLを含むため除外する。
configs/_v1/
configs/_test/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ログ
logs/
*.log

# 一時ファイル・ロック
tmp_query.sql
# 調査ツールの取得キャッシュ（collect_city_slugs.py / probe_ur.py の既定 --cache-dir）
tmp/
# 同上（collect_leopalace_slugs.py / 新規サイトの実測。1サイトで数十MBになる）。
# ⚠ 回帰テストに使うぶんは tests/fixtures/ へコピーして**そちらを版として残す**。
data/probe/
.claude/scheduled_tasks.lock

# v1（Go）の成果物。実装は legacy-go ブランチ / v1-go-final タグに保全済み
*.exe
*.exe~

# Playwright MCP デバッグ出力（ブラウザ調査時に自動生成される一時ファイル）
.playwright-mcp/

# Claude Codeのローカル権限設定（個人環境固有のため管理外）
.claude/settings.local.json

# 駅データ.jp の無料版データ（通勤時間の算出に使う）
# ⚠ 再配布不可のためGit管理外。取得手順は data/train_master/README.md
# ⚠ ディレクトリごと除外すると、配下のファイルは否定パターンで戻せない。
#   中身を除外してから README だけ戻す
data/train_master/*
!data/train_master/README.md

# ODPT（公共交通オープンデータセンター）から取得した生データ
# ⚠ 公共交通オープンデータ基本ライセンスは第三者への生データ再配布に制約があるため
#   Git管理外。取得手順は data/odpt/README.md
data/odpt/*
!data/odpt/README.md

# セッション引継ぎメモ（一時ファイル。正典は docs/再設計計画.md と docs/課題管理表.md）
docs/引継ぎ_*.md
