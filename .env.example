# =============================================================
# Database（必須）
# =============================================================
# PostgreSQL接続URL。ローカルDBのユーザー名・パスワードは db/setup.ps1 で作成したものに置き換える
DATABASE_URL=postgres://user:password@localhost:5432/searching_for_houses

# =============================================================
# Discord（必須）
# =============================================================
# エラー通知用グローバルチャンネルのWebhook URL（Discordサーバー設定 > 連携サービス > ウェブフックで取得）
ERROR_DISCORD_WEBHOOK=

# =============================================================
# スクレイピング設定
# =============================================================
# --full-scan 時の最大ページ数（省略時デフォルト: 5）
FULL_SCAN_MAX_PAGES=5

# configs/ ディレクトリのパス（省略時は実行ファイルと同じディレクトリのconfigs/）
CONFIGS_DIR=
