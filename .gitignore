# 環境変数・シークレット
.env
.env.*
!.env.example

# 検索パターン設定
# v2 では Webhook URL を .env へ集約したため、パターンYAML自体はGit管理できる。
# v1 形式の設定（configs/_v1/）と検証用（configs/_test/）は実URLを含むため除外する。
configs/_v1/
configs/_test/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ログ
logs/
*.log

# 一時ファイル・ロック
tmp_query.sql
.claude/scheduled_tasks.lock

# v1（Go）の成果物。実装は legacy-go ブランチ / v1-go-final タグに保全済み
*.exe
*.exe~

# Playwright MCP デバッグ出力（ブラウザ調査時に自動生成される一時ファイル）
.playwright-mcp/

# Claude Codeのローカル権限設定（個人環境固有のため管理外）
.claude/settings.local.json
