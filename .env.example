# =============================================================
# Database（必須）
# =============================================================
# 本番DBの接続URL。パスワードの正典は ~/.claude/.env の DB_APP_PASSWORD
DATABASE_URL=postgresql+psycopg://searching_for_houses:password@localhost:5432/searching_for_houses

# 統合テスト用DB（DB規約: {本番DB名}_test）。未設定時はDB統合テストをスキップする
DATABASE_TEST_URL=postgresql+psycopg://searching_for_houses:password@localhost:5432/searching_for_houses_test

# =============================================================
# Discord Webhook（必須）
# =============================================================
# v2 では Webhook URL をすべてここに集約し、検索パターンYAMLからは
# webhook_ref: CHINTAI_ALONE のように論理名で参照する（YAMLをGit管理に戻すため）。
# 命名規則: DISCORD_WEBHOOK_{webhook_ref を大文字化した値}

# サイト失敗・YAML読込失敗を流すグローバルエラーチャンネル
DISCORD_WEBHOOK_ERRORS=https://discord.com/api/webhooks/xxx/yyy

# 検索パターン「東京賃貸一人暮らし」（webhook_ref: CHINTAI_ALONE）
DISCORD_WEBHOOK_CHINTAI_ALONE=https://discord.com/api/webhooks/xxx/yyy

# =============================================================
# パス設定（省略可）
# =============================================================
# 検索パターンYAMLのディレクトリ（省略時: リポジトリ直下の configs/）
CONFIGS_DIR=

# 設備抽出辞書などGit管理データのディレクトリ（省略時: リポジトリ直下の data/）
DATA_DIR=

# 実行ログの出力先は設定しない。ログの実体は t_scrape_logs（DB）と標準出力で、
# ファイルへ落とすのは scripts/*.ps1 のリダイレクト（リポジトリ直下の logs/ 固定）。

# =============================================================
# スクレイピング設定（省略可）
# =============================================================
# サイト個別設定（m_sites.min_interval_sec）が無い場合のリクエスト間隔（秒）
DEFAULT_MIN_INTERVAL_SEC=2.5

# HTTPリクエストのタイムアウト（秒）
REQUEST_TIMEOUT_SEC=30

# スクレイピング時に名乗る User-Agent
USER_AGENT=house-search/2.0 (personal property watcher)
